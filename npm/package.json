{
  "name": "epwforge-mcp",
  "version": "0.10.0",
  "description": "MCP server for EPWForge — let Claude and other AI agents generate climate-stressed weather files (EPW, DDY) for any global location. Custom TMYx / AMY synthesis from ERA5, CMIP6 future-climate morphing (4 SSPs, 7 percentiles, 21-model ensemble), urban heat island presets, extreme-event injection (heat waves, cold snaps, humidity & wind compound events), and wildfire smoke overlays. For EnergyPlus, OpenStudio, IES VE, eQUEST.",
  "main": "index.js",
  "bin": {
    "epwforge-mcp": "index.js"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node index.js"
  },
